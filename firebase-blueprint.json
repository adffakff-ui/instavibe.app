{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique user ID" },
        "username": { "type": "string", "description": "Display username", "minLength": 3, "maxLength": 30 },
        "usernameLower": { "type": "string", "description": "Normalized lowercase username", "minLength": 3, "maxLength": 30 },
        "fullName": { "type": "string", "description": "Full name of the user", "maxLength": 80 },
        "bio": { "type": "string", "description": "Short user biography", "maxLength": 220 },
        "website": { "type": "string", "description": "Personal website or external profile link", "maxLength": 200 },
        "photoURL": { "type": "string", "description": "URL to profile photo", "maxLength": 900000 },
        "coverPhotoURL": { "type": "string", "description": "URL or compressed image for profile cover photo", "maxLength": 900000 },
        "email": { "type": "string", "description": "User email address", "maxLength": 320 },
        "phoneNumber": { "type": "string", "description": "Verified E.164 mobile phone number", "maxLength": 32 },
        "emailVerified": { "type": "boolean", "description": "Whether the account email has been verified" },
        "authProvider": { "type": "string", "enum": ["google", "password", "phone"], "description": "Authentication provider" },
        "onboardingCompleted": { "type": "boolean", "description": "Whether initial profile setup is finished" },
        "lastLoginAt": { "type": "string", "format": "date-time", "description": "Timestamp of latest login" },
        "interests": { "type": "object", "description": "Map of tag names to interest scores" },
        "storySettings": { "type": "object", "description": "Default story privacy, replies, archive, and sharing preferences" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "email"]
    },
    "UsernameReservation": {
      "title": "UsernameReservation",
      "description": "Unique username ownership lock for registration and profile updates",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner user ID" },
        "username": { "type": "string", "minLength": 3, "maxLength": 30 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "createdAt"]
    },
    "LoginSession": {
      "title": "LoginSession",
      "description": "Authenticated device session record stored per user",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "description": "Unique client session identifier" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "provider": { "type": "string", "enum": ["google", "password", "phone"] },
        "deviceLabel": { "type": "string", "minLength": 1, "maxLength": 100 },
        "platform": { "type": "string", "maxLength": 60 },
        "status": { "type": "string", "enum": ["active", "revoked"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastActiveAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sessionId", "userId", "provider", "deviceLabel", "status", "createdAt", "lastActiveAt"]
    },
    "Post": {
      "title": "Post",
      "description": "A social media post with image or video",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorUsername": { "type": "string" },
        "authorPhotoURL": { "type": "string" },
        "mediaURL": { "type": "string", "maxLength": 900000 },
        "mediaType": { "type": "string", "enum": ["image", "video"] },
        "caption": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "likesCount": { "type": "number" },
        "reactionCounts": { "type": "object", "description": "Map of reaction type to count" },
        "commentsCount": { "type": "number" },
        "viewsCount": { "type": "number", "description": "Number of views on the post" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "mediaURL", "mediaType"]
    },
    "Story": {
      "title": "Story",
      "description": "Short-lived visual content",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorUsername": { "type": "string" },
        "authorPhotoURL": { "type": "string" },
        "mediaURL": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["image", "video"] },
        "caption": { "type": "string" },
        "likesCount": { "type": "number" },
        "reactionCounts": { "type": "object", "description": "Map of reaction type to count" },
        "viewsCount": { "type": "number", "description": "Number of unique views on the story" },
        "tapsForwardCount": { "type": "number", "description": "Number of forward navigation taps on the story" },
        "tapsBackCount": { "type": "number", "description": "Number of backward navigation taps on the story" },
        "repliesCount": { "type": "number", "description": "Number of replies received on the story" },
        "poll": { 
          "type": "object",
          "description": "Optional interactive poll sticker",
          "properties": {
            "question": { "type": "string" },
            "optionA": { "type": "string" },
            "optionB": { "type": "string" },
            "votesA": { "type": "number" },
            "votesB": { "type": "number" },
            "voters": { "type": "object" }
          }
        },
        "music": {
          "type": "object",
          "description": "Optional soundtrack or music sticker attached to story",
          "properties": {
            "title": { "type": "string" },
            "artist": { "type": "string" },
            "genre": { "type": "string" }
          }
        },
        "template": {
          "type": "object",
          "description": "Optional template sticker attached to story",
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "prompt": { "type": "string" }
          }
        },
        "collage": {
          "type": "object",
          "description": "Optional layout or collage configuration",
          "properties": {
            "count": { "type": "number" },
            "style": { "type": "string" }
          }
        },
        "audience": {
          "type": "string",
          "enum": ["everyone", "close_friends"],
          "description": "Target audience for the story"
        },
        "closeFriendIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Bounded list of close friend UIDs allowed to see close_friends stories"
        },
        "allowReplies": {
          "type": "boolean",
          "description": "Whether replies and reactions are enabled on the story"
        },
        "allowComments": {
          "type": "boolean",
          "description": "Whether comments and replies are enabled on the story"
        },
        "aiLabel": {
          "type": "boolean",
          "description": "Whether the story carries an AI-generated content disclosure label"
        },
        "filterId": {
          "type": "string",
          "maxLength": 40,
          "description": "Visual effect preset ID applied to the story"
        },
        "textOverlays": {
          "type": "array",
          "description": "Positioned text overlays on the story canvas"
        },
        "stickers": {
          "type": "array",
          "description": "Positioned stickers (emoji, location, time, mood) on the story canvas"
        },
        "mentions": {
          "type": "array",
          "description": "User mentions tagged on the story"
        },
        "partnership": {
          "type": "object",
          "description": "Optional paid partnership or collaboration tag",
          "properties": {
            "isPaid": { "type": "boolean" },
            "allowAds": { "type": "boolean" },
            "partnerId": { "type": "string" },
            "partnerUsername": { "type": "string" }
          }
        },
        "promoted": {
          "type": "object",
          "description": "Optional story promotion/boost configuration"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "mediaURL"]
    },
    "Like": {
      "title": "Like",
      "description": "A post or reel like/reaction interaction",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "userPhotoURL": { "type": "string" },
        "reaction": { "type": "string", "enum": ["heart", "love", "laugh", "wow", "fire", "clap"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "userId"]
    },
    "StoryReaction": {
      "title": "StoryReaction",
      "description": "A persistent like or emoji reaction on a story",
      "type": "object",
      "properties": {
        "storyId": { "type": "string" },
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "userPhotoURL": { "type": "string" },
        "reaction": { "type": "string", "enum": ["heart", "love", "laugh", "wow", "fire", "clap"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["storyId", "userId", "reaction"]
    },
    "Comment": {
      "title": "Comment",
      "description": "A post comment interaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "postId": { "type": "string" },
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "userPhotoURL": { "type": "string" },
        "text": { "type": "string" },
        "likesCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "userId", "text"]
    },
    "CommentLike": {
      "title": "CommentLike",
      "description": "A like on a specific post comment",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "commentId": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["commentId", "userId"]
    },
    "Follow": {
      "title": "Follow",
      "description": "User follow relationship",
      "type": "object",
      "properties": {
        "followerId": { "type": "string" },
        "followingId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["followerId", "followingId"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "A direct message conversation between two users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participantIds": { "type": "array", "description": "Array of 2 user IDs" },
        "lastMessage": { "type": "string" },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["participantIds"]
    },
    "Message": {
      "title": "Message",
      "description": "A single message in a conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "mediaURL": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["image", "video"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["conversationId", "senderId"]
    },
    "Notification": {
      "title": "Notification",
      "description": "An in-app notification for likes, follows, messages, or silent story expiration notices",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipientId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderUsername": { "type": "string", "maxLength": 50 },
        "senderPhotoURL": { "type": "string", "maxLength": 900000 },
        "type": { "type": "string", "enum": ["like", "follow", "message", "comment", "story_expiring"] },
        "postId": { "type": "string" },
        "storyId": { "type": "string" },
        "storyMediaURL": { "type": "string", "maxLength": 900000 },
        "storyMediaType": { "type": "string", "enum": ["image", "video"] },
        "expiresAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "silent": { "type": "boolean" },
        "actionTaken": { "type": "string", "enum": ["kept", "deleted"] },
        "handledAt": { "type": "string", "format": "date-time" },
        "text": { "type": "string", "maxLength": 1000 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recipientId", "senderId", "type"]
    },
    "Block": {
      "title": "Block",
      "description": "User block relationship",
      "type": "object",
      "properties": {
        "blockerId": { "type": "string" },
        "blockedId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["blockerId", "blockedId"]
    },
    "CloseFriend": {
      "title": "CloseFriend",
      "description": "User close friends list entry for private Close Friends stories",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "friendId": { "type": "string" },
        "username": { "type": "string", "maxLength": 50 },
        "photoURL": { "type": "string", "maxLength": 900000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "friendId", "createdAt"]
    },
    "HighlightAlbum": {
      "title": "HighlightAlbum",
      "description": "A collection of favorite stories saved permanently on a profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "coverImageURL": { "type": "string" },
        "storyIds": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title"]
    },
    "LiveStream": {
      "title": "LiveStream",
      "description": "A real-time live video/audio broadcast session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "hostId": { "type": "string" },
        "hostUsername": { "type": "string", "minLength": 1, "maxLength": 50 },
        "hostPhotoURL": { "type": "string", "maxLength": 900000 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": { "type": "string", "minLength": 1, "maxLength": 40 },
        "thumbnailURL": { "type": "string", "maxLength": 250000 },
        "status": { "type": "string", "enum": ["live", "ended"] },
        "allowComments": { "type": "boolean" },
        "pinnedMessage": { "type": "string", "maxLength": 300 },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "peakViewers": { "type": "number" },
        "guestId": { "type": "string" },
        "guestUsername": { "type": "string", "maxLength": 50 },
        "guestPhotoURL": { "type": "string", "maxLength": 900000 },
        "guestStatus": { "type": "string", "enum": ["none", "invited", "active"] },
        "guestCamEnabled": { "type": "boolean" },
        "guestMicEnabled": { "type": "boolean" },
        "startedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["hostId", "hostUsername", "title", "category", "status", "allowComments"]
    },
    "LiveComment": {
      "title": "LiveComment",
      "description": "A real-time chat message inside a live stream",
      "type": "object",
      "properties": {
        "streamId": { "type": "string" },
        "userId": { "type": "string" },
        "username": { "type": "string", "minLength": 1, "maxLength": 50 },
        "userPhotoURL": { "type": "string", "maxLength": 900000 },
        "text": { "type": "string", "minLength": 1, "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["streamId", "userId", "username", "text"]
    },
    "LiveViewer": {
      "title": "LiveViewer",
      "description": "Active viewer presence inside a live stream",
      "type": "object",
      "properties": {
        "streamId": { "type": "string" },
        "userId": { "type": "string" },
        "username": { "type": "string", "minLength": 1, "maxLength": 50 },
        "photoURL": { "type": "string", "maxLength": 900000 },
        "joinedAt": { "type": "string", "format": "date-time" },
        "lastSeen": { "type": "number" }
      },
      "required": ["streamId", "userId", "username", "lastSeen"]
    },
    "LiveReaction": {
      "title": "LiveReaction",
      "description": "A real-time floating reaction during a live broadcast",
      "type": "object",
      "properties": {
        "streamId": { "type": "string" },
        "userId": { "type": "string" },
        "emoji": { "type": "string", "enum": ["heart", "fire", "clap", "laugh", "love", "wow", "party", "sparkles"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["streamId", "userId", "emoji"]
    },
    "LiveSignal": {
      "title": "LiveSignal",
      "description": "WebRTC peer-to-peer signaling message between broadcaster and viewer",
      "type": "object",
      "properties": {
        "streamId": { "type": "string" },
        "fromUid": { "type": "string" },
        "toUid": { "type": "string" },
        "type": { "type": "string", "enum": ["join", "offer", "answer", "candidate", "leave"] },
        "channel": { "type": "string", "enum": ["host", "guest"] },
        "sdp": { "type": "string", "maxLength": 25000 },
        "sdpType": { "type": "string", "maxLength": 20 },
        "candidate": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["streamId", "fromUid", "toUid", "type"]
    },
    "GuestRequest": {
      "title": "GuestRequest",
      "description": "A viewer request to co-host a live stream",
      "type": "object",
      "properties": {
        "streamId": { "type": "string" },
        "userId": { "type": "string" },
        "username": { "type": "string", "minLength": 1, "maxLength": 50 },
        "photoURL": { "type": "string", "maxLength": 900000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["streamId", "userId", "username"]
    },
    "SavedPost": {
      "title": "SavedPost",
      "description": "A bookmarked post saved by a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "postId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorUsername": { "type": "string" },
        "authorPhotoURL": { "type": "string" },
        "mediaURL": { "type": "string", "maxLength": 900000 },
        "mediaType": { "type": "string", "enum": ["image", "video"] },
        "caption": { "type": "string" },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "savedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "postId", "mediaURL", "mediaType"]
    },
    "Report": {
      "title": "Report",
      "description": "Content moderation report submitted by a user for a post or profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reporterId": { "type": "string", "description": "UID of user submitting the report" },
        "reporterUsername": { "type": "string", "maxLength": 50 },
        "targetType": { "type": "string", "enum": ["post", "profile"] },
        "targetId": { "type": "string", "description": "ID of reported post or UID of reported profile" },
        "targetAuthorId": { "type": "string", "description": "UID of author of post or profile owner" },
        "targetUsername": { "type": "string", "maxLength": 50 },
        "targetSummary": { "type": "string", "maxLength": 500, "description": "Summary or caption of reported item" },
        "reason": { "type": "string", "enum": ["spam", "harassment", "inappropriate", "hate_speech", "misinformation", "impersonation", "violence", "copyright", "other"] },
        "reasonLabel": { "type": "string", "maxLength": 100 },
        "details": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["pending", "reviewed", "resolved", "dismissed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reporterId", "targetType", "targetId", "reason", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Global feed posts"
    },
    "/stories/{storyId}": {
      "schema": "Story",
      "description": "Active stories"
    },
    "/stories/{storyId}/reactions/{userId}": {
      "schema": "StoryReaction",
      "description": "Persistent likes and emoji reactions on stories"
    },
    "/posts/{postId}/likes/{userId}": {
      "schema": "Like",
      "description": "Post likes"
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Post comments"
    },
    "/posts/{postId}/comments/{commentId}/likes/{userId}": {
      "schema": "CommentLike",
      "description": "Likes on individual comments"
    },
    "/users/{userId}/following/{followingId}": {
      "schema": "Follow",
      "description": "Users this user follows"
    },
    "/users/{userId}/followers/{followerId}": {
      "schema": "Follow",
      "description": "Users following this user"
    },
    "/users/{userId}/highlights/{albumId}": {
      "schema": "HighlightAlbum",
      "description": "User story highlight albums"
    },
    "/users/{userId}/closeFriends/{friendId}": {
      "schema": "CloseFriend",
      "description": "User close friends list"
    },
    "/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Direct message conversations"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages within a conversation"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications"
    },
    "/users/{userId}/blockedUsers/{blockedId}": {
      "schema": "Block",
      "description": "Users blocked by this user"
    },
    "/liveStreams/{streamId}": {
      "schema": "LiveStream",
      "description": "Live broadcast sessions"
    },
    "/liveStreams/{streamId}/comments/{commentId}": {
      "schema": "LiveComment",
      "description": "Real-time comments in a live stream"
    },
    "/liveStreams/{streamId}/viewers/{viewerId}": {
      "schema": "LiveViewer",
      "description": "Active viewers in a live stream"
    },
    "/liveStreams/{streamId}/reactions/{reactionId}": {
      "schema": "LiveReaction",
      "description": "Live floating reactions"
    },
    "/liveStreams/{streamId}/signals/{signalId}": {
      "schema": "LiveSignal",
      "description": "WebRTC signaling messages for a live stream"
    },
    "/liveStreams/{streamId}/guestRequests/{userId}": {
      "schema": "GuestRequest",
      "description": "Requests from viewers to join as live co-host"
    },
    "/users/{userId}/savedPosts/{postId}": {
      "schema": "SavedPost",
      "description": "Posts bookmarked by a user"
    },
    "/usernames/{usernameKey}": {
      "schema": "UsernameReservation",
      "description": "Unique lowercase username reservation records"
    },
    "/users/{userId}/loginSessions/{sessionId}": {
      "schema": "LoginSession",
      "description": "Active and revoked login sessions for a user"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "User submitted reports for content moderation"
    }
  }
}
