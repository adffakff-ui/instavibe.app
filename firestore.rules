rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // 1. Global Safety Net & Helpers
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // -------------------------------------------------------------------------
    // 2. Entity Validations
    // -------------------------------------------------------------------------

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'username', 'email'])
        && data.keys().hasOnly(['uid', 'username', 'usernameLower', 'fullName', 'bio', 'photoURL', 'email', 'emailVerified', 'authProvider', 'onboardingCompleted', 'lastLoginAt', 'interests', 'createdAt'])
        && data.uid == request.auth.uid
        && data.username is string && data.username.size() >= 3 && data.username.size() <= 30
        && data.email is string && data.email.size() <= 320
        && (!('usernameLower' in data) || data.usernameLower == null || (data.usernameLower is string && data.usernameLower.size() >= 3 && data.usernameLower.size() <= 30))
        && (!('fullName' in data) || data.fullName == null || (data.fullName is string && data.fullName.size() <= 80))
        && (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 220))
        && (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 900000))
        && (!('emailVerified' in data) || data.emailVerified is bool)
        && (!('authProvider' in data) || data.authProvider in ['google', 'password'])
        && (!('onboardingCompleted' in data) || data.onboardingCompleted is bool);
    }

    function isValidUsernameReservation(data) {
      return data.keys().hasAll(['uid', 'username', 'createdAt'])
        && data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && data.uid == request.auth.uid
        && data.username is string
        && data.username.size() >= 3 && data.username.size() <= 30;
    }

    function isValidLoginSession(data) {
      return data.keys().hasAll(['sessionId', 'userId', 'provider', 'deviceLabel', 'status', 'createdAt', 'lastActiveAt'])
        && data.keys().hasOnly(['sessionId', 'userId', 'provider', 'deviceLabel', 'platform', 'status', 'createdAt', 'lastActiveAt'])
        && isValidId(data.sessionId)
        && data.userId == request.auth.uid
        && data.provider in ['google', 'password']
        && data.deviceLabel is string && data.deviceLabel.size() >= 1 && data.deviceLabel.size() <= 100
        && (!('platform' in data) || data.platform == null || (data.platform is string && data.platform.size() <= 60))
        && data.status in ['active', 'revoked'];
    }

    function isValidPost(data) {
      return data.keys().hasAll(['authorId', 'mediaURL', 'mediaType'])
        && data.keys().hasOnly(['id', 'authorId', 'authorUsername', 'authorPhotoURL', 'mediaURL', 'mediaType', 'caption', 'tags', 'likesCount', 'reactionCounts', 'commentsCount', 'createdAt'])
        && data.authorId == request.auth.uid
        && data.mediaURL is string && data.mediaURL.size() >= 1 && data.mediaURL.size() <= 900000
        && data.mediaType in ['image', 'video']
        && (!('caption' in data) || data.caption == null || (data.caption is string && data.caption.size() <= 2200))
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 30 && (data.tags.size() == 0 || data.tags[0] is string)))
        && (!('reactionCounts' in data) || data.reactionCounts == null || data.reactionCounts is map);
    }

    function isValidStory(data) {
      return data.keys().hasAll(['authorId', 'mediaURL'])
        && data.keys().hasOnly(['id', 'authorId', 'authorUsername', 'authorPhotoURL', 'mediaURL', 'mediaType', 'caption', 'likesCount', 'reactionCounts', 'poll', 'createdAt', 'expiresAt'])
        && data.authorId == request.auth.uid
        && data.mediaURL is string && data.mediaURL.size() <= 900000
        && (!('mediaType' in data) || data.mediaType == null || data.mediaType in ['image', 'video'])
        && (!('caption' in data) || data.caption == null || (data.caption is string && data.caption.size() <= 1000))
        && (!('likesCount' in data) || data.likesCount == null || (data.likesCount is number && data.likesCount >= 0))
        && (!('reactionCounts' in data) || data.reactionCounts == null || data.reactionCounts is map)
        && (!('poll' in data) || data.poll == null || (data.poll is map))
        && (!('expiresAt' in data) || data.expiresAt == null || (data.expiresAt is string && data.expiresAt.size() <= 64));
    }

    function isValidComment(data) {
      return data.keys().hasAll(['postId', 'userId', 'text'])
        && data.keys().hasOnly(['id', 'postId', 'userId', 'username', 'userPhotoURL', 'text', 'likesCount', 'createdAt'])
        && data.userId == request.auth.uid
        && data.text is string && data.text.size() <= 1000
        && (data.likesCount == null || data.likesCount is number);
    }

    function isValidCommentLike(data) {
      return data.keys().hasAll(['commentId', 'userId'])
        && data.keys().hasOnly(['postId', 'commentId', 'userId', 'createdAt'])
        && data.userId == request.auth.uid;
    }

    function isValidLike(data) {
      return data.keys().hasAll(['postId', 'userId'])
        && data.keys().hasOnly(['postId', 'userId', 'username', 'userPhotoURL', 'reaction', 'createdAt'])
        && data.userId == request.auth.uid
        && (!('username' in data) || data.username == null || (data.username is string && data.username.size() <= 50))
        && (!('userPhotoURL' in data) || data.userPhotoURL == null || (data.userPhotoURL is string && data.userPhotoURL.size() <= 900000))
        && (!('reaction' in data) || data.reaction in ['heart', 'love', 'laugh', 'wow', 'fire', 'clap']);
    }

    function isValidStoryReaction(data) {
      return data.keys().hasAll(['storyId', 'userId', 'reaction'])
        && data.keys().hasOnly(['storyId', 'userId', 'username', 'userPhotoURL', 'reaction', 'createdAt'])
        && isValidId(data.storyId)
        && data.userId == request.auth.uid
        && data.reaction in ['heart', 'love', 'laugh', 'wow', 'fire', 'clap']
        && (!('username' in data) || data.username == null || (data.username is string && data.username.size() <= 50))
        && (!('userPhotoURL' in data) || data.userPhotoURL == null || (data.userPhotoURL is string && data.userPhotoURL.size() <= 900000));
    }

    function isValidPostStatsUpdate(data) {
      return (!('likesCount' in data) || (data.likesCount is number && data.likesCount >= 0))
        && (!('commentsCount' in data) || (data.commentsCount is number && data.commentsCount >= 0))
        && (!('reactionCounts' in data) || data.reactionCounts == null || (data.reactionCounts is map && data.reactionCounts.size() <= 10));
    }

    function isValidStoryStatsUpdate(data) {
      return (!('likesCount' in data) || data.likesCount == null || (data.likesCount is number && data.likesCount >= 0))
        && (!('reactionCounts' in data) || data.reactionCounts == null || (data.reactionCounts is map && data.reactionCounts.size() <= 10))
        && (!('poll' in data) || data.poll == null || data.poll is map);
    }

    function isValidHighlight(data) {
      return data.keys().hasAll(['userId', 'title'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'coverImageURL', 'storyIds', 'createdAt'])
        && data.userId == request.auth.uid
        && data.title is string && data.title.size() <= 50
        && (!('coverImageURL' in data) || data.coverImageURL == null || (data.coverImageURL is string && data.coverImageURL.size() <= 900000))
        && (!('storyIds' in data) || data.storyIds == null || (data.storyIds is list && data.storyIds.size() <= 30));
    }

    function isValidSavedPost(data) {
      return data.keys().hasAll(['userId', 'postId', 'mediaURL', 'mediaType'])
        && data.keys().hasOnly(['userId', 'postId', 'authorId', 'authorUsername', 'authorPhotoURL', 'mediaURL', 'mediaType', 'caption', 'likesCount', 'commentsCount', 'savedAt'])
        && data.userId == request.auth.uid
        && isValidId(data.postId)
        && data.mediaURL is string && data.mediaURL.size() >= 1 && data.mediaURL.size() <= 900000
        && data.mediaType in ['image', 'video']
        && (!('authorId' in data) || data.authorId == null || isValidId(data.authorId))
        && (!('authorUsername' in data) || data.authorUsername == null || (data.authorUsername is string && data.authorUsername.size() <= 50))
        && (!('authorPhotoURL' in data) || data.authorPhotoURL == null || (data.authorPhotoURL is string && data.authorPhotoURL.size() <= 900000))
        && (!('caption' in data) || data.caption == null || (data.caption is string && data.caption.size() <= 2200))
        && (!('likesCount' in data) || data.likesCount == null || (data.likesCount is number && data.likesCount >= 0))
        && (!('commentsCount' in data) || data.commentsCount == null || (data.commentsCount is number && data.commentsCount >= 0));
    }

    function isValidLiveStream(data) {
      return data.keys().hasAll(['hostId', 'hostUsername', 'title', 'category', 'status', 'allowComments', 'startedAt'])
        && data.keys().hasOnly(['id', 'hostId', 'hostUsername', 'hostPhotoURL', 'title', 'category', 'thumbnailURL', 'status', 'allowComments', 'pinnedMessage', 'likesCount', 'commentsCount', 'peakViewers', 'guestId', 'guestUsername', 'guestPhotoURL', 'guestStatus', 'guestCamEnabled', 'guestMicEnabled', 'startedAt', 'endedAt'])
        && isValidId(data.hostId)
        && data.hostUsername is string && data.hostUsername.size() >= 1 && data.hostUsername.size() <= 50
        && (!('hostPhotoURL' in data) || data.hostPhotoURL == null || (data.hostPhotoURL is string && data.hostPhotoURL.size() <= 900000))
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 40
        && (!('thumbnailURL' in data) || data.thumbnailURL == null || (data.thumbnailURL is string && data.thumbnailURL.size() <= 250000))
        && data.status in ['live', 'ended']
        && data.allowComments is bool
        && (!('pinnedMessage' in data) || data.pinnedMessage == null || (data.pinnedMessage is string && data.pinnedMessage.size() <= 300))
        && (!('likesCount' in data) || (data.likesCount is number && data.likesCount >= 0))
        && (!('commentsCount' in data) || (data.commentsCount is number && data.commentsCount >= 0))
        && (!('peakViewers' in data) || (data.peakViewers is number && data.peakViewers >= 0))
        && (!('guestId' in data) || data.guestId == null || isValidId(data.guestId))
        && (!('guestUsername' in data) || data.guestUsername == null || (data.guestUsername is string && data.guestUsername.size() <= 50))
        && (!('guestPhotoURL' in data) || data.guestPhotoURL == null || (data.guestPhotoURL is string && data.guestPhotoURL.size() <= 900000))
        && (!('guestStatus' in data) || data.guestStatus in ['none', 'invited', 'active'])
        && (!('guestCamEnabled' in data) || data.guestCamEnabled is bool)
        && (!('guestMicEnabled' in data) || data.guestMicEnabled is bool);
    }

    function isValidLiveComment(data) {
      return data.keys().hasAll(['streamId', 'userId', 'username', 'text', 'createdAt'])
        && data.keys().hasOnly(['streamId', 'userId', 'username', 'userPhotoURL', 'text', 'createdAt'])
        && isValidId(data.streamId)
        && data.userId == request.auth.uid
        && data.username is string && data.username.size() >= 1 && data.username.size() <= 50
        && (!('userPhotoURL' in data) || data.userPhotoURL == null || (data.userPhotoURL is string && data.userPhotoURL.size() <= 900000))
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 300;
    }

    function isValidLiveViewer(data) {
      return data.keys().hasAll(['streamId', 'userId', 'username', 'lastSeen'])
        && data.keys().hasOnly(['streamId', 'userId', 'username', 'photoURL', 'joinedAt', 'lastSeen'])
        && isValidId(data.streamId)
        && data.userId == request.auth.uid
        && data.username is string && data.username.size() >= 1 && data.username.size() <= 50
        && (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 900000))
        && data.lastSeen is number && data.lastSeen > 0;
    }

    function isValidLiveReaction(data) {
      return data.keys().hasAll(['streamId', 'userId', 'emoji', 'createdAt'])
        && data.keys().hasOnly(['streamId', 'userId', 'emoji', 'createdAt'])
        && isValidId(data.streamId)
        && data.userId == request.auth.uid
        && data.emoji in ['heart', 'fire', 'clap', 'laugh', 'love', 'wow', 'party', 'sparkles'];
    }

    function isValidLiveSignal(data) {
      return data.keys().hasAll(['streamId', 'fromUid', 'toUid', 'type', 'createdAt'])
        && data.keys().hasOnly(['streamId', 'fromUid', 'toUid', 'type', 'channel', 'sdp', 'sdpType', 'candidate', 'createdAt'])
        && isValidId(data.streamId)
        && isValidId(data.fromUid)
        && isValidId(data.toUid)
        && data.fromUid == request.auth.uid
        && data.type in ['join', 'offer', 'answer', 'candidate', 'leave']
        && (!('channel' in data) || data.channel in ['host', 'guest'])
        && (!('sdp' in data) || data.sdp == null || (data.sdp is string && data.sdp.size() <= 25000))
        && (!('sdpType' in data) || data.sdpType == null || (data.sdpType is string && data.sdpType.size() <= 20))
        && (!('candidate' in data) || data.candidate == null || data.candidate is map);
    }

    function isValidGuestRequest(data) {
      return data.keys().hasAll(['streamId', 'userId', 'username', 'createdAt'])
        && data.keys().hasOnly(['streamId', 'userId', 'username', 'photoURL', 'createdAt'])
        && isValidId(data.streamId)
        && data.userId == request.auth.uid
        && data.username is string && data.username.size() >= 1 && data.username.size() <= 50
        && (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 900000));
    }

    function isValidConversation(data) {
      return data.keys().hasAll(['participantIds'])
        && data.keys().hasOnly(['id', 'participantIds', 'lastMessage', 'lastMessageAt', 'updatedAt'])
        && data.participantIds is list
        && data.participantIds.size() == 2
        && data.participantIds[0] is string && isValidId(data.participantIds[0])
        && data.participantIds[1] is string && isValidId(data.participantIds[1])
        && (!('lastMessage' in data) || data.lastMessage == null || (data.lastMessage is string && data.lastMessage.size() <= 2000))
        && (!('lastMessageAt' in data) || data.lastMessageAt == null || data.lastMessageAt is timestamp);
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['conversationId', 'senderId'])
        && data.keys().hasOnly(['id', 'conversationId', 'senderId', 'text', 'mediaURL', 'mediaType', 'createdAt'])
        && isValidId(data.conversationId)
        && data.senderId == request.auth.uid
        && (!('text' in data) || data.text == null || (data.text is string && data.text.size() <= 4000))
        && (!('mediaURL' in data) || data.mediaURL == null || (data.mediaURL is string && data.mediaURL.size() <= 900000))
        && (!('mediaType' in data) || data.mediaType == null || data.mediaType in ['image', 'video']);
    }

    // -------------------------------------------------------------------------
    // 3. Collection Rules
    // -------------------------------------------------------------------------

    function isBlocked(blockerId, userId) {
      return exists(/databases/$(database)/documents/users/$(blockerId)/blockedUsers/$(userId));
    }

    match /usernames/{usernameKey} {
      allow get: if isSignedIn() && isValidId(usernameKey) && usernameKey.matches('^[a-z0-9_]{3,30}$');
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(usernameKey)
        && usernameKey.matches('^[a-z0-9_]{3,30}$')
        && isValidUsernameReservation(incoming())
        && incoming().username.lower() == usernameKey
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isSignedIn()
        && isValidId(usernameKey)
        && existing().uid == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidUser(incoming()) && isOwner(userId);
      allow update: if isSignedIn()
        && isOwner(userId)
        && isValidUser(incoming())
        && incoming().uid == existing().uid
        && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt);

      match /loginSessions/{sessionId} {
        allow get: if isSignedIn() && isOwner(userId) && isValidId(sessionId);
        allow list: if isSignedIn() && isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isSignedIn()
          && isOwner(userId)
          && isValidId(sessionId)
          && isValidLoginSession(incoming())
          && incoming().sessionId == sessionId
          && incoming().createdAt == request.time
          && incoming().lastActiveAt == request.time;
        allow update: if isSignedIn()
          && isOwner(userId)
          && isValidId(sessionId)
          && isValidLoginSession(incoming())
          && incoming().sessionId == existing().sessionId
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().lastActiveAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'lastActiveAt', 'deviceLabel', 'platform']);
        allow delete: if isSignedIn() && isOwner(userId) && isValidId(sessionId);
      }

      match /blockedUsers/{blockedId} {
        allow get: if isSignedIn() && (isOwner(userId) || isOwner(blockedId));
        allow list: if isSignedIn() && isOwner(userId);
        allow create, update, delete: if isSignedIn() && isOwner(userId);
      }

      match /highlights/{albumId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isOwner(userId) && isValidHighlight(incoming()) && incoming().createdAt == request.time;
        allow update: if isSignedIn() && isOwner(userId) && isValidHighlight(incoming()) && incoming().createdAt == existing().createdAt;
        allow delete: if isSignedIn() && isOwner(userId);
      }

      match /savedPosts/{postId} {
        allow get: if isSignedIn() && isOwner(userId) && isValidId(postId);
        allow list: if isSignedIn() && isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isSignedIn() && isOwner(userId) && isValidId(postId) && isValidSavedPost(incoming()) && incoming().postId == postId && incoming().savedAt == request.time;
        allow update: if isSignedIn() && isOwner(userId) && isValidId(postId) && isValidSavedPost(incoming()) && incoming().postId == postId;
        allow delete: if isSignedIn() && isOwner(userId) && isValidId(postId);
      }
    }

    match /posts/{postId} {
      allow get: if isSignedIn() && isValidId(postId) && (resource == null || !isBlocked(resource.data.authorId, request.auth.uid));
      allow list: if isSignedIn(); // Filtering is usually done client-side for lists, but 'get' is guarded
      allow create: if isSignedIn() && isValidId(postId) && isValidPost(incoming()) && incoming().createdAt == request.time;
      allow update: if isSignedIn() && isValidId(postId) && (
        (isOwner(existing().authorId) && isValidPost(incoming()) && incoming().createdAt == existing().createdAt)
        || (isValidPostStatsUpdate(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'reactionCounts']) && !isBlocked(existing().authorId, request.auth.uid))
      );
      allow delete: if isSignedIn() && isValidId(postId) && isOwner(existing().authorId);

      match /likes/{userId} {
        allow get: if isSignedIn() && isValidId(postId) && isValidId(userId);
        allow list: if isSignedIn() && isValidId(postId) && resource.data.postId == postId;
        allow create, update: if isSignedIn() && isValidId(postId) && isValidId(userId) && isOwner(userId) && isValidLike(incoming()) && !isBlocked(get(/databases/$(database)/documents/posts/$(postId)).data.authorId, userId);
        allow delete: if isSignedIn() && isValidId(postId) && isValidId(userId) && isOwner(userId);
      }

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidComment(incoming()) && incoming().createdAt == request.time && !isBlocked(get(/databases/$(database)/documents/posts/$(postId)).data.authorId, incoming().userId);
        allow update: if isSignedIn() && (
          (isOwner(existing().userId) && isValidComment(incoming()))
          || (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount']) && !isBlocked(existing().userId, request.auth.uid))
        );
        allow delete: if isSignedIn() && (isOwner(existing().userId) || isOwner(get(/databases/$(database)/documents/posts/$(postId)).data.authorId));

        match /likes/{userId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn() && isOwner(userId) && isValidCommentLike(incoming()) && !isBlocked(get(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId)).data.userId, userId);
          allow delete: if isSignedIn() && isOwner(userId);
        }
      }
    }

    match /stories/{storyId} {
      allow get: if isSignedIn() && isValidId(storyId) && (resource == null || isOwner(resource.data.authorId) || !isBlocked(resource.data.authorId, request.auth.uid));
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(storyId) && isValidStory(incoming()) && incoming().createdAt == request.time;
      allow update: if isSignedIn() && isValidId(storyId) && (
        (isOwner(existing().authorId) && isValidStory(incoming()) && incoming().createdAt == existing().createdAt)
        || (isValidStoryStatsUpdate(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['poll', 'likesCount', 'reactionCounts']) && !isBlocked(existing().authorId, request.auth.uid))
      );
      allow delete: if isSignedIn() && isValidId(storyId) && isOwner(existing().authorId);

      match /reactions/{userId} {
        allow get: if isSignedIn() && isValidId(storyId) && isValidId(userId) && (
          isOwner(userId)
          || isOwner(get(/databases/$(database)/documents/stories/$(storyId)).data.authorId)
          || !isBlocked(get(/databases/$(database)/documents/stories/$(storyId)).data.authorId, request.auth.uid)
        );
        allow list: if isSignedIn() && isValidId(storyId) && resource.data.storyId == storyId;
        allow create, update: if isSignedIn()
          && isValidId(storyId)
          && isValidId(userId)
          && isOwner(userId)
          && isValidStoryReaction(incoming())
          && incoming().storyId == storyId
          && !isBlocked(get(/databases/$(database)/documents/stories/$(storyId)).data.authorId, userId);
        allow delete: if isSignedIn() && isValidId(storyId) && isValidId(userId) && isOwner(userId);
      }
    }

    function isValidFollow(data, followerId, followingId) {
      return data.keys().hasAll(['followerId', 'followingId', 'createdAt'])
        && data.keys().hasOnly(['followerId', 'followingId', 'createdAt'])
        && isValidId(data.followerId)
        && isValidId(data.followingId)
        && data.followerId == followerId
        && data.followingId == followingId
        && followerId != followingId
        && data.createdAt == request.time;
    }

    match /users/{userId}/following/{followingId} {
      allow get: if isSignedIn() && isValidId(userId) && isValidId(followingId);
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(userId)
        && isValidId(followingId)
        && isOwner(userId)
        && isValidFollow(incoming(), userId, followingId)
        && !isBlocked(followingId, userId)
        && !isBlocked(userId, followingId);
      allow delete: if isSignedIn()
        && isValidId(userId)
        && isValidId(followingId)
        && (isOwner(userId) || isOwner(followingId));
    }

    match /users/{userId}/followers/{followerId} {
      allow get: if isSignedIn() && isValidId(userId) && isValidId(followerId);
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(userId)
        && isValidId(followerId)
        && isOwner(followerId)
        && isValidFollow(incoming(), followerId, userId)
        && !isBlocked(userId, followerId)
        && !isBlocked(followerId, userId);
      allow delete: if isSignedIn()
        && isValidId(userId)
        && isValidId(followerId)
        && (isOwner(followerId) || isOwner(userId));
    }

    function isParticipant(participantIds) {
      return isSignedIn() && participantIds is list && request.auth.uid in participantIds;
    }

    match /conversations/{conversationId} {
      allow get: if isSignedIn() && isValidId(conversationId) && (
        resource == null
          ? conversationId.matches('.*' + request.auth.uid + '.*')
          : isParticipant(resource.data.participantIds)
      );
      allow list: if isSignedIn() && isParticipant(resource.data.participantIds);
      allow create: if isSignedIn()
        && isValidId(conversationId)
        && isValidConversation(incoming())
        && isParticipant(incoming().participantIds)
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(conversationId)
        && isParticipant(existing().participantIds)
        && isValidConversation(incoming())
        && incoming().participantIds == existing().participantIds
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'updatedAt']);
      allow delete: if isSignedIn()
        && isValidId(conversationId)
        && isParticipant(existing().participantIds);

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && isValidId(conversationId)
          && isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds);
        allow create: if isSignedIn()
          && isValidId(conversationId)
          && isValidId(messageId)
          && isValidMessage(incoming())
          && incoming().conversationId == conversationId
          && incoming().createdAt == request.time
          && isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds);
      }
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn()
        && isValidId(userId)
        && isValidId(notificationId)
        && incoming().senderId == request.auth.uid
        && incoming().recipientId == userId
        && incoming().type in ['like', 'follow', 'message', 'comment']
        && !isBlocked(userId, request.auth.uid);
      allow update: if isSignedIn() && isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    match /liveStreams/{streamId} {
      allow get: if isSignedIn() && isValidId(streamId) && (resource == null || !isBlocked(resource.data.hostId, request.auth.uid));
      allow list: if isSignedIn() && resource.data.status in ['live', 'ended'];
      allow create: if isSignedIn()
        && isValidId(streamId)
        && isValidLiveStream(incoming())
        && incoming().hostId == request.auth.uid
        && incoming().status == 'live'
        && incoming().startedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(streamId)
        && existing().status == 'live'
        && isValidLiveStream(incoming())
        && (
          (isOwner(existing().hostId)
            && incoming().hostId == existing().hostId
            && incoming().startedAt == existing().startedAt
            && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'allowComments', 'pinnedMessage', 'thumbnailURL', 'status', 'endedAt', 'peakViewers', 'guestId', 'guestUsername', 'guestPhotoURL', 'guestStatus', 'guestCamEnabled', 'guestMicEnabled']))
          || (existing().guestId == request.auth.uid
            && existing().guestStatus in ['invited', 'active']
            && incoming().hostId == existing().hostId
            && incoming().startedAt == existing().startedAt
            && incoming().diff(existing()).affectedKeys().hasOnly(['guestId', 'guestUsername', 'guestPhotoURL', 'guestStatus', 'guestCamEnabled', 'guestMicEnabled'])
            && ((incoming().guestStatus == 'active' && incoming().guestId == request.auth.uid)
              || (incoming().guestStatus == 'none' && incoming().guestId == null)))
          || (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'peakViewers'])
            && !isBlocked(existing().hostId, request.auth.uid))
        );
      allow delete: if isSignedIn() && isValidId(streamId) && isOwner(existing().hostId);

      match /comments/{commentId} {
        allow read: if isSignedIn() && isValidId(streamId) && !isBlocked(get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostId, request.auth.uid);
        allow create: if isSignedIn()
          && isValidId(streamId)
          && isValidId(commentId)
          && isValidLiveComment(incoming())
          && incoming().streamId == streamId
          && incoming().createdAt == request.time
          && get(/databases/$(database)/documents/liveStreams/$(streamId)).data.status == 'live'
          && get(/databases/$(database)/documents/liveStreams/$(streamId)).data.allowComments == true
          && !isBlocked(get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostId, request.auth.uid);
        allow delete: if isSignedIn()
          && isValidId(streamId)
          && isValidId(commentId)
          && (isOwner(existing().userId) || isOwner(get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostId));
      }

      match /viewers/{viewerId} {
        allow read: if isSignedIn() && isValidId(streamId);
        allow create: if isSignedIn()
          && isValidId(streamId)
          && isValidId(viewerId)
          && isOwner(viewerId)
          && isValidLiveViewer(incoming())
          && incoming().streamId == streamId
          && get(/databases/$(database)/documents/liveStreams/$(streamId)).data.status == 'live'
          && !isBlocked(get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostId, viewerId);
        allow update: if isSignedIn()
          && isValidId(streamId)
          && isValidId(viewerId)
          && isOwner(viewerId)
          && isValidLiveViewer(incoming())
          && incoming().streamId == existing().streamId
          && incoming().userId == existing().userId
          && incoming().diff(existing()).affectedKeys().hasOnly(['lastSeen', 'username', 'photoURL']);
        allow delete: if isSignedIn()
          && isValidId(streamId)
          && isValidId(viewerId)
          && (isOwner(viewerId) || isOwner(get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostId));
      }

      match /reactions/{reactionId} {
        allow read: if isSignedIn() && isValidId(streamId);
        allow create: if isSignedIn()
          && isValidId(streamId)
          && isValidId(reactionId)
          && isValidLiveReaction(incoming())
          && incoming().streamId == streamId
          && incoming().createdAt == request.time
          && get(/databases/$(database)/documents/liveStreams/$(streamId)).data.status == 'live'
          && !isBlocked(get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostId, request.auth.uid);
        allow delete: if isSignedIn()
          && isValidId(streamId)
          && isValidId(reactionId)
          && (isOwner(existing().userId) || isOwner(get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostId));
      }

      match /signals/{signalId} {
        allow get: if isSignedIn() && isValidId(streamId) && isValidId(signalId) && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
        allow list: if isSignedIn() && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
        allow create: if isSignedIn()
          && isValidId(streamId)
          && isValidId(signalId)
          && isValidLiveSignal(incoming())
          && incoming().streamId == streamId
          && incoming().createdAt == request.time
          && !isBlocked(get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostId, request.auth.uid);
        allow delete: if isSignedIn()
          && isValidId(streamId)
          && isValidId(signalId)
          && (existing().toUid == request.auth.uid || existing().fromUid == request.auth.uid || isOwner(get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostId));
      }

      match /guestRequests/{requesterId} {
        allow read: if isSignedIn() && isValidId(streamId);
        allow create: if isSignedIn()
          && isValidId(streamId)
          && isValidId(requesterId)
          && isOwner(requesterId)
          && isValidGuestRequest(incoming())
          && incoming().streamId == streamId
          && incoming().createdAt == request.time
          && get(/databases/$(database)/documents/liveStreams/$(streamId)).data.status == 'live'
          && !isBlocked(get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostId, requesterId);
        allow delete: if isSignedIn()
          && isValidId(streamId)
          && isValidId(requesterId)
          && (isOwner(requesterId) || isOwner(get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostId));
      }
    }
  }
}
